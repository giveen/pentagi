<execution_context>
{{if .Task}}
<global_task>{{.Task.Input}}</global_task>
<task>
<id>{{.Task.ID}}</id>
<title>{{.Task.Title}}</title>
<status>{{.Task.Status}}</status>
</task>
{{else}}
{{if .Tasks}}
<tasks>
{{range .Tasks}}
<task>
<id>{{.ID}}</id>
<title>{{.Title}}</title>
<status>{{.Status}}</status>
</task>
{{end}}
</tasks>
{{end}}
{{end}}
{{if .Subtask}}
<current_subtask>
<id>{{.Subtask.ID}}</id>
<title>{{.Subtask.Title}}</title>
<description>{{.Subtask.Description}}</description>
</current_subtask>
{{end}}
{{if .CompletedSubtasks}}
<completed_subtasks>
{{range .CompletedSubtasks}}
<subtask>
<id>{{.ID}}</id>
<title>{{.Title}}</title>
</subtask>
{{end}}
</completed_subtasks>
{{end}}
{{if .PlannedSubtasks}}
<planned_subtasks>
{{range .PlannedSubtasks}}
<subtask>
<id>{{.ID}}</id>
<title>{{.Title}}</title>
</subtask>
{{end}}
</planned_subtasks>
{{end}}
</execution_context>
